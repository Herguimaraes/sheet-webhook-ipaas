# Porta do servidor HTTP
PORT=3000

# E-mail da Conta de Serviço do Google (Service Account)
# Exemplo: webhook-sheet-bot@seu-projeto-gcp.iam.gserviceaccount.com
GOOGLE_CLIENT_EMAIL=seu-service-account@seu-projeto.iam.gserviceaccount.com

# Chave Privada da Conta de Serviço (incluindo -----BEGIN PRIVATE KEY----- e quebras de linha \n)
# Exemplo: "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC5...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"
