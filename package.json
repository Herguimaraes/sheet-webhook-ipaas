{
  "name": "sheet-webhook-ipaas",
  "version": "1.0.0",
  "description": "Micro-iPaaS focado em Webhooks de pagamento (Hotmart, Hubla, Zouti, TMB) para Google Sheets",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"require('fs').cpSync('public', 'dist/public', {recursive: true, force: true})\"",
    "postinstall": "tsc && node -e \"require('fs').cpSync('public', 'dist/public', {recursive: true, force: true})\"",
    "start": "node dist/server.js",
    "test": "tsx test/runTests.ts && tsx test/e2eTest.ts",
    "test:parsers": "tsx test/runTests.ts",
    "test:e2e": "tsx test/e2eTest.ts"
  },
  "keywords": [
    "ipaas",
    "webhook",
    "google-sheets",
    "hotmart",
    "hubla",
    "zouti",
    "tmb-educacao"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
